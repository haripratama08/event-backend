# Photobox Event Environment Configuration
PORT=3005
HOST=0.0.0.0
BOX_ID=PHOTOBOX_EVENT
BOX_SLUG=box-event

# Mode Opsi B: Cloudflare Tunnel / Public URL
# Jika diisi, QR Code akan otomatis menggunakan URL publik ini.
# Contoh: https://event.ceritakita.id atau https://photobox-event.trycloudflare.com
# Jika kosong, sistem otomatis menggunakan IP LAN aktif komputer (misal http://192.168.1.50:3005)
PUBLIC_BASE_URL=

# Folder Runtime
BASE_PHOTO_FOLDER=runtime/box-event/photos
FRAMES_FOLDER=frames
FRAMES_DATA_FILE=data/frames.json
DEVICE_CONFIG_FILE=config/devices.json
LOG_FILE=state/logs/photobox_event.jsonl

# Konfigurasi Printer Foto
PRINTER_NAME=PHOTO_EVENT
PRINTER_AUTO_REBIND=true
PRINTER_MEDIA=T4X6FULL
PRINTER_MEDIA_TYPE=PLAIN_HIGH
PRINTER_BORDERLESS=true
PRINTER_BORDERLESS_MEDIA_TYPE=GLOSSYPHOTO_HIGH
PRINTER_INK=COLOR
PRINT_WIDTH=2880
PRINT_HEIGHT=4320
PRINT_DPI=720
PRINT_SAFE_SCALE=0.96
PRINT_OFFSET_X_MM=0
PRINT_OFFSET_Y_MM=-1

# Konfigurasi GIF Animasi
GIF_ENABLED=true
GIF_FRAME_DELAY_MS=500
GIF_MAX_WIDTH=720

# Konfigurasi Kamera (Canon DSLR / gphoto2 / Mock Simulator untuk Testing)
# Nilai: 'auto', 'gphoto2', 'mock'
CAMERA_DRIVER=auto
